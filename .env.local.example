# Backend API URL used by the Next.js frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Groq (gsk_...) or OpenAI (sk-...) — detected automatically from the key prefix
OPENAI_API_KEY=gsk-...
# Optional explicit base URL (auto: Groq if key starts with gsk_)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Chat model (Groq example)
OPENAI_MODEL=llama-3.1-8b-instant
# Transcription model (Groq Whisper)
OPENAI_TRANSCRIBE_MODEL=whisper-large-v3
